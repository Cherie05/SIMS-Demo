# Copy to backend/.env and adjust. Every value has a sensible development default.
# Any setting can also come from a file named after it in /run/secrets (Docker/Kubernetes secrets).

# development | test | staging | production. Staging/production refuse weak secrets and hide the API docs.
ENVIRONMENT=development
# ENABLE_API_DOCS=            # override the docs default (on outside staging/production)

# ---------------------------------------------------------------- logging & metrics
LOG_LEVEL=INFO
# LOG_FORMAT=json             # json (default when deployed) or text (default in development)
METRICS_ENABLED=true
# METRICS_TOKEN=              # bearer token required to scrape /metrics

# ---------------------------------------------------------------- database (MySQL 8.4)
DATABASE_URL=mysql+pymysql://sims:sims_password@127.0.0.1:3306/sims
# DATABASE_PASSWORD=          # overrides the password in DATABASE_URL (e.g. from a secret file)
# DATABASE_TLS=preferred      # disabled | preferred | required | verify_ca | verify_identity
# DATABASE_TLS_CA=            # CA certificate path for verify_ca / verify_identity
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_WAIT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- Redis / Valkey (shared rate limits)
# Empty: per-process limits (fine for one instance). Set it when running several API replicas.
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ---------------------------------------------------------------- tokens & sessions
JWT_SECRET_KEY=replace-with-a-long-random-string
# Key rotation: put the old key here when you change JWT_SECRET_KEY; remove it after 15 minutes.
# JWT_PREVIOUS_SECRET_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# COOKIE_SECURE=              # secure cookies need HTTPS; defaults to on when deployed
# Fernet key(s) encrypting authenticator-app secrets at rest, newest first (required when deployed):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEYS=

# ---------------------------------------------------------------- passwords (Argon2id)
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# ---------------------------------------------------------------- one-time codes
LOGIN_OTP_REQUIRED=true
# log: printed to the backend terminal / docker compose logs backend; email: sent via SMTP below
OTP_DELIVERY=log
OTP_TTL_SECONDS=300

# ---------------------------------------------------------------- sign-up
# Self-service sign-up (new accounts are always Sales). Comma-separated domains, empty = any.
SIGNUP_ENABLED=true
SIGNUP_ALLOWED_DOMAINS=

# ---------------------------------------------------------------- abuse protection
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=600
PASSWORD_RESET_MAX_PER_HOUR=5
API_RATE_LIMIT_PER_USER_PER_MINUTE=600
API_RATE_LIMIT_PER_IP_PER_MINUTE=1200
MAX_REQUEST_BODY_BYTES=1048576

# ---------------------------------------------------------------- web
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL used for links inside notification emails
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------- email (SMTP)
# Defaults point at Mailpit on this machine, installed or from docker-compose (inbox: http://localhost:8025).
# Without Mailpit or another SMTP server, set EMAIL_ENABLED=false: emails are then logged as SKIPPED.
EMAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=SIMS Notifications <no-reply@example.com>

# ---------------------------------------------------------------- background worker (python -m app.worker)
WORKER_POLL_SECONDS=1.0
# Prometheus metrics of the worker: this machine only by default (containers use 0.0.0.0)
# WORKER_METRICS_HOST=127.0.0.1
# WORKER_METRICS_PORT=9101
JOB_MAX_ATTEMPTS=6
RETENTION_AUDIT_DAYS=400
RETENTION_JOBS_DAYS=30
RETENTION_EMAIL_LOG_DAYS=365

# ---------------------------------------------------------------- business defaults (editable by admins)
DEFAULT_APPROVAL_THRESHOLD=50000.00
DEFAULT_TAX_RATE=18.00
