# Production settings for docker-compose.prod.yml. Copy to production.env (git-ignored), fill in, and
# keep it readable by the deploying account only (chmod 600). Better still: keep the values in your
# secret manager and render this file at deploy time.
#
# Generate secrets with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fernet key:              python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use URL-safe random values for every password (no quotes or spaces).

# ---------------------------------------------------------------- public address & TLS edge (Caddy)
PUBLIC_URL=https://sims.example.com
# Your domain: Caddy obtains and renews a Let's Encrypt certificate (ports 80 and 443 must be reachable).
# Use :80 when another load balancer terminates TLS in front of this stack.
SITE_ADDRESS=sims.example.com
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- database accounts (least privilege)
MYSQL_ROOT_PASSWORD=
# schema owner: migrations only
MYSQL_PASSWORD=
# the API and the worker: data access, no DDL
MYSQL_APP_PASSWORD=
# backups: read-only
MYSQL_BACKUP_PASSWORD=
# restore verification: scratch database only
MYSQL_RESTORE_PASSWORD=

# ---------------------------------------------------------------- cache (Valkey)
REDIS_PASSWORD=

# ---------------------------------------------------------------- tokens and encryption
JWT_SECRET_KEY=
# During a key rotation: the previous key, removed after 15 minutes (see the runbook)
JWT_PREVIOUS_SECRET_KEYS=
DATA_ENCRYPTION_KEYS=
# Optional bearer token for scraping /metrics
METRICS_TOKEN=

# Required when adding docker-compose.observability.yml; use a distinct generated password.
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SIMS Notifications <no-reply@example.com>

# Production one-time codes are sent over email. Development uses backend logs by default.
OTP_DELIVERY=email
# Self sign-up: off by default in production. When on, limit it to your company's domain(s).
SIGNUP_ENABLED=false
SIGNUP_ALLOWED_DOMAINS=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ---------------------------------------------------------------- backups
# Keep this key in your secret manager as well: without it the backups can't be restored.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Where encrypted backups are written on the host; copy them off-site (see the runbook)
BACKUP_DIR=./backups
